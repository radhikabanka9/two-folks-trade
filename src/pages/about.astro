---
import BaseLayout from '../layouts/BaseLayout.astro';

const timeline = [
  {
    year: '2021',
    title: 'The Beginning',
    desc: 'Two Folks Global Trade House began its journey in Tamil Nadu, supporting MSMEs and manufacturers through distribution, trade, sales, and supply-chain capabilities.'
  },
  {
    year: '2024',
    title: 'Expanding into Food & FMCG',
    desc: 'Partnered with Mannan, a manufacturer of coconut-based products, strengthening our presence in the food and FMCG sector and expanding domestic and international trade capabilities.'
  },
  {
    year: '2025',
    title: 'Kochi Operations & HoReCa',
    desc: 'Established our warehouse and operations in Kochi, Kerala, expanding into the HoReCa sector serving Kochi and Thiruvananthapuram. Developed Folks Mobility to strengthen logistics capabilities.'
  },
  {
    year: '2026',
    title: 'Bangalore & Retail Expansion',
    desc: 'Expanded operations into Bangalore and launched Folks Retail, extending reach across modern trade, e-commerce, and quick commerce in Kochi and Bangalore.'
  }
];

const values = [
  { title: 'Commitment', desc: 'We take ownership of our commitments and deliver with accountability.' },
  { title: 'Professionalism', desc: 'We maintain high standards across communication, documentation, commercial dealings, and execution.' },
  { title: 'Documentation', desc: 'Structured documentation and processes support smoother, more reliable trade operations.' },
  { title: 'Integrated Supply Chain', desc: 'Connected sourcing, inventory, warehousing, distribution, and logistics create a coordinated supply chain.' },
  { title: 'Quality Control', desc: 'We maintain strong attention to product quality, handling, process discipline, and appropriate checks throughout the supply chain.' },
  { title: 'Adaptability', desc: 'We remain flexible and responsive, adapting our approach to changing markets, regulations, and business conditions.' }
];
---

<BaseLayout title="About Us | Two Folks Global Trade House">
  <!-- Hero Section -->
  <section class="relative overflow-hidden pt-16 pb-20 md:pt-24 md:pb-28 bg-gradient-to-b from-white via-slate-50 to-slate-100/60 border-b border-slate-200/60">
    <div class="max-w-4xl mx-auto px-6 text-center">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-blue-50 border border-blue-100 text-blue-700 text-xs font-semibold uppercase tracking-wider mb-6">
        <span class="w-1.5 h-1.5 rounded-full bg-blue-600"></span>
        Our Mission & Story
      </div>
      <h1 class="text-4xl md:text-5xl font-extrabold text-slate-900 tracking-tight leading-tight mb-6">
        Connecting Great Products with the <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-600 to-indigo-600">Right Markets</span>
      </h1>
      <p class="text-base md:text-lg text-slate-600 max-w-2xl mx-auto leading-relaxed">
        Two Folks is evolving from a regional startup into an integrated trade and distribution enterprise connecting manufacturers, MSMEs, and global brands with dynamic consumer markets.
      </p>
    </div>
  </section>

  <!-- Mission & Vision -->
  <section class="py-20 max-w-6xl mx-auto px-6 grid md:grid-cols-2 gap-8">
    <div class="bg-white p-8 md:p-10 rounded-2xl border border-slate-200/90 shadow-xs hover:border-blue-200 transition-all">
      <span class="text-xs font-bold uppercase tracking-wider px-3 py-1 rounded-full bg-blue-50 text-blue-700 inline-block mb-4">
        Our Mission
      </span>
      <h2 class="text-2xl font-bold text-slate-900 mb-4">Simplify Distribution & Trade</h2>
      <p class="text-slate-600 text-sm leading-relaxed mb-4">
        To simplify distribution and international trade by creating reliable, efficient routes between manufacturers, brands, and markets.
      </p>
      <p class="text-slate-500 text-sm leading-relaxed">
        Through disciplined execution across documentation, warehousing, supply chain, sales, distribution, and logistics, we take responsibility for the complexities involved in moving products across markets.
      </p>
    </div>

    <div class="bg-white p-8 md:p-10 rounded-2xl border border-slate-200/90 shadow-xs hover:border-blue-200 transition-all">
      <span class="text-xs font-bold uppercase tracking-wider px-3 py-1 rounded-full bg-blue-50 text-blue-700 inline-block mb-4">
        Our Vision
      </span>
      <h2 class="text-2xl font-bold text-slate-900 mb-4">A Trusted Global Network</h2>
      <p class="text-slate-600 text-sm leading-relaxed mb-4">
        To build a trusted global distribution and trade network connecting great products, manufacturers, brands, and markets across India and the world.
      </p>
      <p class="text-slate-500 text-sm leading-relaxed">
        We create an integrated ecosystem through which businesses can access distribution, export, import, warehousing, logistics, and market channels through one dependable partner.
      </p>
    </div>
  </section>

  <!-- Capabilities Pill Grid -->
  <section class="py-16 bg-slate-50 border-y border-slate-200/80 px-6">
    <div class="max-w-6xl mx-auto">
      <div class="text-center max-w-xl mx-auto mb-12">
        <span class="text-xs font-bold uppercase tracking-widest text-blue-600 block mb-2">Integrated Capabilities</span>
        <h2 class="text-3xl font-extrabold text-slate-900 tracking-tight">Full-Spectrum Execution</h2>
      </div>

      <div class="grid grid-cols-2 md:grid-cols-5 gap-4 text-center">
        {['Supply Chain', 'Warehousing', 'Sales Execution', 'Logistics', 'Documentation'].map((cap, i) => (
          <div class="bg-white p-6 rounded-xl border border-slate-200/80 shadow-xs">
            <span class="text-xs font-bold text-blue-600 block mb-1">0{i + 1}</span>
            <h4 class="font-bold text-slate-900 text-sm">{cap}</h4>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Journey Timeline -->
  <section class="py-24 max-w-4xl mx-auto px-6">
    <div class="text-center max-w-xl mx-auto mb-16">
      <span class="text-xs font-bold uppercase tracking-widest text-blue-600 block mb-2">Growth & Evolution</span>
      <h2 class="text-3xl md:text-4xl font-extrabold text-slate-900 tracking-tight">Our Journey</h2>
    </div>

    <div class="relative border-l-2 border-slate-200 ml-4 md:ml-8 space-y-12 pl-6 md:pl-10">
      {timeline.map((item) => (
        <div class="relative group">
          <div class="absolute -left-[31px] md:-left-[47px] top-1.5 w-4 h-4 rounded-full bg-white border-4 border-blue-600"></div>
          <div class="bg-white p-6 md:p-8 rounded-2xl border border-slate-200/90 shadow-xs group-hover:border-blue-200 transition-all">
            <span class="text-xs font-extrabold text-blue-600 tracking-wider uppercase block mb-1">{item.year}</span>
            <h3 class="text-lg font-bold text-slate-900 mb-2">{item.title}</h3>
            <p class="text-slate-600 text-sm leading-relaxed">{item.desc}</p>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Values -->
  <section class="py-20 bg-white border-t border-slate-200 px-6">
    <div class="max-w-6xl mx-auto">
      <div class="text-center max-w-xl mx-auto mb-16">
        <span class="text-xs font-bold uppercase tracking-widest text-blue-600 block mb-2">Our Foundation</span>
        <h2 class="text-3xl font-extrabold text-slate-900 tracking-tight">Built on Trust. Driven by Execution.</h2>
      </div>

      <div class="grid md:grid-cols-3 gap-6">
        {values.map(val => (
          <div class="p-6 rounded-xl bg-slate-50 border border-slate-200/80">
            <h4 class="font-bold text-slate-900 mb-2 text-base">{val.title}</h4>
            <p class="text-slate-600 text-xs leading-relaxed">{val.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>