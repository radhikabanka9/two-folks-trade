---
import BaseLayout from '../layouts/BaseLayout.astro';

const channels = [
  {
    title: 'Modern Trade Distribution',
    subtitle: 'Supermarkets • Hypermarkets • Organised Retail',
    description: 'We help brands build sustained volume across modern trade and hypermarkets through dedicated account management, joint business planning, store merchandising, and planogram execution.'
  },
  {
    title: 'E-commerce & Quick Commerce',
    subtitle: 'Amazon • Flipkart • BigBasket • Swiggy & Blinkit',
    description: 'Digital distribution combining catalog listing, rapid dark-store replenishment, inventory forecasting, dedicated logistics support, and strict fill-rate management.'
  },
  {
    title: 'B2B & HoReCa Distribution',
    subtitle: 'Hotels • Restaurants • Cafes • Commercial Kitchens',
    description: 'Direct institutional supply for commercial kitchens and food-service operators across Kochi, Thiruvananthapuram, and Bangalore with bulk order fulfillment.'
  }
];

const infrastructure = [
  {
    title: 'Supply Chain Management',
    points: ['Demand planning and forecasting', 'Inventory planning and management', 'Order management and fulfillment', 'Last-mile delivery coordination']
  },
  {
    title: 'Kochi Warehousing Hub',
    points: ['Strategic facility in Kochi, Kerala', 'Multi-category inventory storage', 'Regional dispatch and stock coordination', 'Scalable support for emerging manufacturers']
  },
  {
    title: 'Technology & Logistics',
    points: ['Route optimization and delivery scheduling', 'Order and consignment tracking', 'Folks Mobility fleet support', 'Cost-efficient logistics coordination']
  },
  {
    title: 'Regulatory & Documentation',
    points: ['Distribution documentation', 'Regulatory process coordination', 'Trade compliance management', 'Structured process records']
  }
];
---

<BaseLayout title="Distribution Solutions | Two Folks Global Trade House">
  <!-- Hero Section -->
  <section class="relative overflow-hidden pt-16 pb-20 md:pt-24 md:pb-28 bg-gradient-to-b from-white via-slate-50 to-slate-100/60 border-b border-slate-200/60">
    <div class="max-w-4xl mx-auto px-6 text-center">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-blue-50 border border-blue-100 text-blue-700 text-xs font-semibold uppercase tracking-wider mb-6">
        <span class="w-1.5 h-1.5 rounded-full bg-blue-600"></span>
        Kerala & South India Hub
      </div>
      <h1 class="text-4xl md:text-5xl font-extrabold text-slate-900 tracking-tight leading-tight mb-6">
        Reliable Distribution Solutions for <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-600 to-indigo-600">Brands & Manufacturers</span>
      </h1>
      <p class="text-base md:text-lg text-slate-600 max-w-2xl mx-auto leading-relaxed">
        Connecting products with the right customers and sales channels through an integrated network covering supply chain management, warehousing, sales, and logistics.
      </p>
    </div>
  </section>

  <!-- Channels Grid -->
  <section class="py-20 max-w-7xl mx-auto px-6">
    <div class="text-center max-w-xl mx-auto mb-16">
      <span class="text-xs font-bold uppercase tracking-widest text-blue-600 block mb-2">Market Reach</span>
      <h2 class="text-3xl md:text-4xl font-extrabold text-slate-900 tracking-tight">Active Sales Channels</h2>
    </div>

    <div class="grid md:grid-cols-3 gap-8">
      {channels.map((channel) => (
        <div class="bg-white p-8 rounded-2xl border border-slate-200/90 shadow-xs hover:border-blue-200 hover:shadow-lg transition-all flex flex-col justify-between">
          <div>
            <span class="text-xs font-bold uppercase tracking-wider text-blue-600 block mb-3">{channel.subtitle}</span>
            <h3 class="text-xl font-bold text-slate-900 mb-4">{channel.title}</h3>
            <p class="text-slate-600 text-sm leading-relaxed mb-6">{channel.description}</p>
          </div>
          <div class="pt-4 border-t border-slate-100">
            <span class="text-xs font-bold uppercase tracking-wider text-slate-900 flex items-center gap-1">
              Active Channel Support &rarr;
            </span>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Infrastructure -->
  <section class="py-20 bg-slate-50 border-t border-slate-200/80 px-6">
    <div class="max-w-6xl mx-auto">
      <div class="text-center max-w-xl mx-auto mb-16">
        <span class="text-xs font-bold uppercase tracking-widest text-blue-600 block mb-2">Operations</span>
        <h2 class="text-3xl font-extrabold text-slate-900 tracking-tight">Supply Chain & Infrastructure</h2>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
        {infrastructure.map((block) => (
          <div class="p-6 rounded-2xl bg-white border border-slate-200/90 shadow-xs">
            <h4 class="font-bold text-slate-900 mb-4 text-base">{block.title}</h4>
            <ul class="space-y-3">
              {block.points.map((pt) => (
                <li class="text-slate-600 text-xs flex items-start gap-2 leading-normal">
                  <span class="h-1.5 w-1.5 rounded-full bg-blue-600 mt-1 flex-shrink-0"></span>
                  <span>{pt}</span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA Banner -->
  <section class="py-20 bg-white px-6">
    <div class="max-w-4xl mx-auto rounded-3xl bg-gradient-to-r from-blue-600 to-indigo-700 p-10 md:p-14 text-white text-center shadow-xl">
      <h2 class="text-3xl md:text-4xl font-extrabold mb-4 tracking-tight">Need distribution across Kerala and South India?</h2>
      <p class="text-blue-100 text-sm md:text-base max-w-xl mx-auto mb-8 leading-relaxed">
        Let our team evaluate your product line and connect your inventory to established retail and foodservice routes.
      </p>
      <a 
        href="/contact" 
        class="inline-block px-8 py-3.5 bg-white hover:bg-slate-100 text-blue-900 font-bold text-sm rounded-full shadow transition-all active:scale-95"
      >
        Inquire for Distribution
      </a>
    </div>
  </section>
</BaseLayout>