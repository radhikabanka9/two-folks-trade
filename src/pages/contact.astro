---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Contact & Trade Inquiries" description="Get in touch with Two Folks Global Trade House for distribution, export, and import inquiries.">
  <!-- Hero Section -->
  <section class="bg-[#0F1E36] text-white py-16 px-6 text-center border-b border-[#B38A4B]/30">
    <div class="max-w-3xl mx-auto">
      <span class="inline-block px-3 py-1 bg-[#B38A4B]/20 border border-[#B38A4B]/40 text-[#B38A4B] text-xs font-semibold uppercase tracking-widest rounded-full mb-4">
        Partner Inquiries
      </span>
      <h1 class="text-4xl md:text-5xl font-serif font-bold mb-3">Connect with Two Folks</h1>
      <p class="text-gray-300 text-sm md:text-base max-w-xl mx-auto">
        Whether you are an Indian manufacturer, international brand, or commercial buyer, reach out to explore how we can move your products forward.
      </p>
    </div>
  </section>

  <section class="py-16 max-w-6xl mx-auto px-6">
    <div class="grid md:grid-cols-3 gap-10">
      <!-- Contact Information Sidebar -->
      <div class="space-y-6">
        <div class="bg-white p-6 rounded-lg border border-gray-200 shadow-sm">
          <h3 class="font-serif font-bold text-lg text-[#0F1E36] mb-2">Operational Hubs</h3>
          <ul class="text-xs text-gray-600 space-y-3">
            <li>
              <strong class="text-[#0F1E36] block">Kochi, Kerala</strong>
              Regional warehouse & logistics operations hub
            </li>
            <li>
              <strong class="text-[#0F1E36] block">Bangalore, Karnataka</strong>
              Commercial operations & retail channel expansion
            </li>
            <li>
              <strong class="text-[#0F1E36] block">Tamil Nadu</strong>
              Foundational origin & manufacturer sourcing
            </li>
          </ul>
        </div>

        <div class="bg-white p-6 rounded-lg border border-gray-200 shadow-sm">
          <h3 class="font-serif font-bold text-lg text-[#0F1E36] mb-2">Trade Desks</h3>
          <p class="text-xs text-gray-600 leading-relaxed mb-3">
            Our trade coordinators typically review and respond to institutional and distribution inquiries within 24 to 48 business hours.
          </p>
          <div class="border-t border-gray-100 pt-3">
            <span class="text-[11px] font-semibold text-[#B38A4B] uppercase tracking-wider block">Channels Served</span>
            <p class="text-xs text-gray-500 mt-1">B2B • HoReCa • Modern Trade • Quick Commerce • Cross-Border</p>
          </div>
        </div>
      </div>

      <!-- Inquiry Form -->
      <div class="md:col-span-2 bg-white p-8 md:p-10 rounded-lg border border-gray-200 shadow-sm">
        <h2 class="text-2xl font-serif font-bold text-[#0F1E36] mb-6">Trade & Partnership Inquiry</h2>
        
        <form class="space-y-6">
          <div class="grid md:grid-cols-2 gap-6">
            <div>
              <label class="block text-xs font-semibold uppercase tracking-wider text-[#0F1E36] mb-2">Your Name *</label>
              <input type="text" required class="w-full px-4 py-2.5 border border-gray-300 rounded focus:ring-1 focus:ring-[#B38A4B] focus:outline-none text-sm" placeholder="Full Name" />
            </div>
            <div>
              <label class="block text-xs font-semibold uppercase tracking-wider text-[#0F1E36] mb-2">Company / Entity Name *</label>
              <input type="text" required class="w-full px-4 py-2.5 border border-gray-300 rounded focus:ring-1 focus:ring-[#B38A4B] focus:outline-none text-sm" placeholder="Business / Brand Name" />
            </div>
          </div>

          <div class="grid md:grid-cols-2 gap-6">
            <div>
              <label class="block text-xs font-semibold uppercase tracking-wider text-[#0F1E36] mb-2">Email Address *</label>
              <input type="email" required class="w-full px-4 py-2.5 border border-gray-300 rounded focus:ring-1 focus:ring-[#B38A4B] focus:outline-none text-sm" placeholder="name@company.com" />
            </div>
            <div>
              <label class="block text-xs font-semibold uppercase tracking-wider text-[#0F1E36] mb-2">Phone / WhatsApp Number *</label>
              <input type="tel" required class="w-full px-4 py-2.5 border border-gray-300 rounded focus:ring-1 focus:ring-[#B38A4B] focus:outline-none text-sm" placeholder="+91 ..." />
            </div>
          </div>

          <div>
            <label class="block text-xs font-semibold uppercase tracking-wider text-[#0F1E36] mb-2">Nature of Partnership *</label>
            <select class="w-full px-4 py-2.5 border border-gray-300 rounded focus:ring-1 focus:ring-[#B38A4B] focus:outline-none text-sm bg-white">
              <option>Domestic Distribution (Kerala, South India, Modern Trade)</option>
              <option>B2B / HoReCa Commercial Supply</option>
              <option>Export Services (India to Global Markets)</option>
              <option>Enter India Desk (Import & Indian Market Entry)</option>
              <option>Bulk Buyer / Sourcing Inquiry</option>
            </select>
          </div>

          <div>
            <label class="block text-xs font-semibold uppercase tracking-wider text-[#0F1E36] mb-2">Message / Requirement Overview *</label>
            <textarea rows="4" required class="w-full px-4 py-2.5 border border-gray-300 rounded focus:ring-1 focus:ring-[#B38A4B] focus:outline-none text-sm" placeholder="Please outline your products, estimated volumes, target channels, or specific requirements..."></textarea>
          </div>

          <button type="submit" class="w-full bg-[#B38A4B] hover:bg-[#D4AF37] text-[#0F1E36] font-bold py-3 px-6 rounded transition-all text-sm uppercase tracking-wider shadow">
            Submit Trade Inquiry
          </button>
        </form>
      </div>
    </div>
  </section>
</BaseLayout>
