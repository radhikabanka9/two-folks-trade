---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Contact & Inquiries | Two Folks Global Trade House">
  <!-- Hero Section -->
  <section class="relative overflow-hidden pt-16 pb-20 md:pt-24 md:pb-28 bg-gradient-to-b from-white via-slate-50 to-slate-100/60 border-b border-slate-200/60">
    <div class="max-w-4xl mx-auto px-6 text-center">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-blue-50 border border-blue-100 text-blue-700 text-xs font-semibold uppercase tracking-wider mb-6">
        <span class="w-1.5 h-1.5 rounded-full bg-blue-600"></span>
        Trade & Partnerships
      </div>
      <h1 class="text-4xl md:text-5xl font-extrabold text-slate-900 tracking-tight leading-tight mb-4">
        Connect with <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-600 to-indigo-600">Two Folks</span>
      </h1>
      <p class="text-base md:text-lg text-slate-600 max-w-xl mx-auto leading-relaxed">
        Whether you are an Indian manufacturer, international brand, or commercial buyer, reach out to explore how we can move your products forward.
      </p>
    </div>
  </section>

  <!-- Form and Hubs Grid -->
  <section class="py-20 max-w-6xl mx-auto px-6">
    <div class="grid md:grid-cols-3 gap-10">
      
      <!-- Hubs Sidebar -->
      <div class="space-y-6">
        <div class="bg-white p-6 rounded-2xl border border-slate-200/90 shadow-xs">
          <h3 class="font-bold text-base text-slate-900 mb-3">Operational Hubs</h3>
          <ul class="text-xs text-slate-600 space-y-4">
            <li>
              <strong class="text-slate-900 block font-semibold mb-0.5">Kochi, Kerala</strong>
              Regional warehouse & logistics operations hub
            </li>
            <li>
              <strong class="text-slate-900 block font-semibold mb-0.5">Bangalore, Karnataka</strong>
              Commercial operations & retail channel expansion
            </li>
            <li>
              <strong class="text-slate-900 block font-semibold mb-0.5">Tamil Nadu</strong>
              Foundational origin & manufacturer sourcing
            </li>
          </ul>
        </div>

        <div class="bg-white p-6 rounded-2xl border border-slate-200/90 shadow-xs">
          <h3 class="font-bold text-base text-slate-900 mb-2">Trade Desks</h3>
          <p class="text-xs text-slate-500 leading-relaxed mb-4">
            Our trade coordinators typically review and respond to institutional and distribution inquiries within 24 to 48 business hours.
          </p>
          <div class="border-t border-slate-100 pt-3">
            <span class="text-[10px] font-bold text-blue-600 uppercase tracking-wider block">Channels Served</span>
            <p class="text-xs text-slate-500 mt-1">B2B • HoReCa • Modern Trade • Quick Commerce • Cross-Border</p>
          </div>
        </div>
      </div>

      <!-- Modern Form -->
      <div class="md:col-span-2 bg-white p-8 md:p-10 rounded-2xl border border-slate-200/90 shadow-xs">
        <h2 class="text-2xl font-bold text-slate-900 mb-6">Trade Inquiry Form</h2>
        
        <form class="space-y-6">
          <div class="grid md:grid-cols-2 gap-6">
            <div>
              <label class="block text-xs font-semibold text-slate-700 mb-2">Your Name *</label>
              <input type="text" required class="w-full px-4 py-3 border border-slate-200 rounded-xl focus:ring-2 focus:ring-blue-500/20 focus:border-blue-600 focus:outline-none text-sm transition-all" placeholder="Full Name" />
            </div>
            <div>
              <label class="block text-xs font-semibold text-slate-700 mb-2">Company / Entity Name *</label>
              <input type="text" required class="w-full px-4 py-3 border border-slate-200 rounded-xl focus:ring-2 focus:ring-blue-500/20 focus:border-blue-600 focus:outline-none text-sm transition-all" placeholder="Business / Brand Name" />
            </div>
          </div>

          <div class="grid md:grid-cols-2 gap-6">
            <div>
              <label class="block text-xs font-semibold text-slate-700 mb-2">Email Address *</label>
              <input type="email" required class="w-full px-4 py-3 border border-slate-200 rounded-xl focus:ring-2 focus:ring-blue-500/20 focus:border-blue-600 focus:outline-none text-sm transition-all" placeholder="name@company.com" />
            </div>
            <div>
              <label class="block text-xs font-semibold text-slate-700 mb-2">Phone / WhatsApp *</label>
              <input type="tel" required class="w-full px-4 py-3 border border-slate-200 rounded-xl focus:ring-2 focus:ring-blue-500/20 focus:border-blue-600 focus:outline-none text-sm transition-all" placeholder="+91 ..." />
            </div>
          </div>

          <div>
            <label class="block text-xs font-semibold text-slate-700 mb-2">Nature of Partnership *</label>
            <select class="w-full px-4 py-3 border border-slate-200 rounded-xl focus:ring-2 focus:ring-blue-500/20 focus:border-blue-600 focus:outline-none text-sm bg-white transition-all">
              <option>Domestic Distribution (Kerala, South India, Modern Trade)</option>
              <option>B2B / HoReCa Commercial Supply</option>
              <option>Export Services (India to Global Markets)</option>
              <option>Enter India Desk (Import & Indian Market Entry)</option>
              <option>Bulk Buyer / Sourcing Inquiry</option>
            </select>
          </div>

          <div>
            <label class="block text-xs font-semibold text-slate-700 mb-2">Message / Requirement Overview *</label>
            <textarea rows="4" required class="w-full px-4 py-3 border border-slate-200 rounded-xl focus:ring-2 focus:ring-blue-500/20 focus:border-blue-600 focus:outline-none text-sm transition-all" placeholder="Please outline your products, estimated volumes, target channels, or specific requirements..."></textarea>
          </div>

          <button type="submit" class="w-full bg-slate-900 hover:bg-blue-600 text-white font-bold py-3.5 px-6 rounded-full transition-all text-sm shadow active:scale-98">
            Submit Trade Inquiry
          </button>
        </form>
      </div>
    </div>
  </section>
</BaseLayout>