---
import BaseLayout from '../layouts/BaseLayout.astro';

const eximSteps = [
  { step: '01', title: 'Source', desc: 'Supplier identification, manufacturer coordination, and bulk procurement specifications.' },
  { step: '02', title: 'Package', desc: 'Export packing standards, commercial labeling compliance, and shipment prep.' },
  { step: '03', title: 'Document', desc: 'Commercial invoices, shipping bills, certificates of origin, and compliance paperwork.' },
  { step: '04', title: 'Ship', desc: 'Freight forwarding, multi-modal transport coordination, and delivery scheduling.' },
  { step: '05', title: 'Warehouse', desc: 'Storage, stock handling, cargo consolidation, and regional fulfillment via Kochi hub.' },
  { step: '06', title: 'Distribute', desc: 'Connecting goods with retail channels, buyers, institutions, and consumers.' }
];

const corridors = [
  {
    title: 'Export: India to Global Markets',
    badge: 'Outbound Desk',
    description: 'We help Indian manufacturers, emerging brands, and MSMEs take products to international buyers with structured cross-border execution.',
    points: [
      'International buyer and distributor connections',
      'Export packaging and compliant labeling',
      'Customs documentation and trade compliance',
      'Port-to-port freight coordination'
    ]
  },
  {
    title: 'Import: Enter India Desk',
    badge: 'Inbound Market Entry',
    description: 'A dedicated launchpad for overseas brands and MSMEs seeking to enter, establish, and grow sustainably across the Indian market.',
    points: [
      'Comprehensive India market viability study',
      'Customs clearance and import documentation',
      'Bonded and regional warehousing in Kochi',
      'Integrated distribution across HoReCa and retail'
    ]
  }
];
---

<BaseLayout title="Export & Import Services | Two Folks Global Trade House">
  <!-- Hero Section -->
  <section class="relative overflow-hidden pt-16 pb-20 md:pt-24 md:pb-28 bg-gradient-to-b from-white via-slate-50 to-slate-100/60 border-b border-slate-200/60">
    <div class="max-w-4xl mx-auto px-6 text-center">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-blue-50 border border-blue-100 text-blue-700 text-xs font-semibold uppercase tracking-wider mb-6">
        <span class="w-1.5 h-1.5 rounded-full bg-blue-600"></span>
        Cross-Border Trade Desk
      </div>
      <h1 class="text-4xl md:text-5xl font-extrabold text-slate-900 tracking-tight leading-tight mb-6">
        Connecting Indian & <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-600 to-indigo-600">Global Markets</span>
      </h1>
      <p class="text-base md:text-lg text-slate-600 max-w-2xl mx-auto leading-relaxed">
        Two Folks Global Trade House provides structured export and import services for manufacturers, MSMEs, brands, and bulk buyers with dependable trade execution.
      </p>
    </div>
  </section>

  <!-- Process Steps -->
  <section class="py-20 max-w-7xl mx-auto px-6">
    <div class="text-center max-w-xl mx-auto mb-16">
      <span class="text-xs font-bold uppercase tracking-widest text-blue-600 block mb-2">Execution Pipeline</span>
      <h2 class="text-3xl md:text-4xl font-extrabold text-slate-900 tracking-tight">The EXIM Process</h2>
    </div>

    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-4">
      {eximSteps.map((item) => (
        <div class="bg-white p-6 rounded-2xl border border-slate-200/90 shadow-xs hover:border-blue-200 transition-all flex flex-col justify-between">
          <div>
            <span class="text-xs font-bold text-blue-600 block mb-2">{item.step}</span>
            <h3 class="text-base font-bold text-slate-900 mb-2">{item.title}</h3>
            <p class="text-slate-500 text-xs leading-relaxed">{item.desc}</p>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Two-Way Corridors -->
  <section class="py-20 bg-slate-50 border-y border-slate-200/80 px-6">
    <div class="max-w-6xl mx-auto">
      <div class="text-center max-w-xl mx-auto mb-16">
        <span class="text-xs font-bold uppercase tracking-widest text-blue-600 block mb-2">Trade Corridors</span>
        <h2 class="text-3xl font-extrabold text-slate-900 tracking-tight">Outbound Export & Inbound Import</h2>
      </div>

      <div class="grid md:grid-cols-2 gap-8">
        {corridors.map((corridor) => (
          <div class="bg-white p-8 md:p-10 rounded-2xl border border-slate-200/90 shadow-xs flex flex-col justify-between hover:border-blue-200 transition-all">
            <div>
              <span class="text-xs font-bold uppercase tracking-wider px-3 py-1 rounded-full bg-blue-50 text-blue-700 inline-block mb-4">
                {corridor.badge}
              </span>
              <h3 class="text-2xl font-bold text-slate-900 mb-4">{corridor.title}</h3>
              <p class="text-slate-600 text-sm leading-relaxed mb-6">{corridor.description}</p>
              
              <ul class="space-y-3 mb-8 border-t border-slate-100 pt-6">
                {corridor.points.map((pt) => (
                  <li class="text-xs text-slate-700 flex items-start gap-2.5 font-medium">
                    <span class="h-1.5 w-1.5 rounded-full bg-blue-600 mt-1 flex-shrink-0"></span>
                    <span>{pt}</span>
                  </li>
                ))}
              </ul>
            </div>

            <div class="pt-4 border-t border-slate-100">
              <a href="/contact" class="text-xs font-bold uppercase tracking-wider text-slate-900 hover:text-blue-600 transition-colors">
                Connect With This Desk &rarr;
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- MSME Scale Callout -->
  <section class="py-20 bg-white px-6">
    <div class="max-w-4xl mx-auto rounded-3xl bg-slate-900 p-10 md:p-14 text-white text-center shadow-xl">
      <h2 class="text-3xl md:text-4xl font-extrabold mb-4 tracking-tight">Supporting Businesses of Different Scales</h2>
      <p class="text-slate-400 text-sm md:text-base max-w-xl mx-auto mb-8 leading-relaxed">
        From emerging MSMEs and local artisanal manufacturers to global FMCG enterprises, we customize documentation, shipping schedules, and warehousing allocations to match your scale.
      </p>
      <a 
        href="/contact" 
        class="inline-block px-8 py-3.5 bg-blue-600 hover:bg-blue-500 text-white font-bold text-sm rounded-full shadow transition-all active:scale-95"
      >
        Initiate Trade Dialogue
      </a>
    </div>
  </section>
</BaseLayout>